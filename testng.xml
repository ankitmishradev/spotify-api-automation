<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Spotify API Test Suite">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="listener.TestListener"/>
    </listeners>
    <test name="Authorization Tests">
        <classes>
            <class name="tests.AuthorizationTests">
                <methods />
            </class>
        </classes>
    </test>
    <test name="User Tests">
        <classes>
            <class name="tests.UserTests"/>
        </classes>
    </test>
    <test name="Playlist Tests">
        <classes>
            <class name="tests.PlaylistTests"/>
        </classes>
    </test>
    <test name="Artist Tests">
        <classes>
            <class name="tests.ArtistTests"/>
        </classes>
    </test>
    <test name="Track Tests">
        <classes>
            <class name="tests.TrackTests"/>
        </classes>
    </test>
    <test name="Album Tests">
        <classes>
            <class name="tests.AlbumTests"/>
        </classes>
    </test>
</suite>