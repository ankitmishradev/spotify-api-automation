<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%t] %-5level %logger{36} - %msg%n"
                           patternSelector="org.apache.logging.log4j.core.pattern.HighlightPatternSelector"
                           defaultPattern="[%t] %highlight{%p}{FATAL=red bold,ERROR=red, WARN=yellow bold, INFO=green bold, DEBUG=cyan, TRACE=blue} %c{1.} - %msg%n"/>
        </Console>
<!--        <File name="FileAppender" fileName="application-${date:yyyyMMdd}.log" immediateFlush="false" append="true">-->
<!--            <PatternLayout pattern="%d{yyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>-->
<!--        </File>-->
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="Console" />
<!--            <AppenderRef ref="FileAppender"/>-->
        </Root>
    </Loggers>
</Configuration>